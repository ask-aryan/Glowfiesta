# ==============================================================
# Supabase (PostgreSQL) + Vercel Test Environment Configuration
# ==============================================================

# 1. Supabase Database Connection String:
# In Supabase dashboard: Project Settings -> Database -> Connection string -> URI
# - If using Transaction Pooler (recommended for Vercel serverless):
#   DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# - Or direct connection:
#   DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# 2. Encrypted session cookie secret (minimum 32 characters)
SESSION_SECRET="test-supabase-vercel-secret-key-diwali-2026-treasure-hunt!!"

# 3. Base App URL (used to generate QR scan links)
# Set to your Vercel URL when deploying, or http://localhost:3000 for local testing
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
