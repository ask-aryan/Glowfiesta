<configuration>
  <system.webServer>
    <!-- Configure iisnode handler for Node.js -->
    <handlers>
      <add name="iisnode" path="server.iis.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- URL Rewrite rules to pass traffic to Next.js server -->
    <rewrite>
      <rules>
        <!-- Do not interfere with iisnode debugging or logs -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.iis.js\/debug[\/]?" />
        </rule>

        <!-- Static content in public or _next/static is served directly or forwarded -->
        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}" />
        </rule>

        <!-- All other requests forwarded to iisnode entrypoint -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.iis.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- iisnode operational settings -->
    <iisnode
      nodeProcessCommandLine="&quot;%ProgramFiles%\nodejs\node.exe&quot;"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="false"
    />
  </system.webServer>
</configuration>
