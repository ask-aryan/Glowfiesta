# GlowFiesta Environment Configuration for Docker Production
# Copy this to .env on your Oracle Linux server

# Database connection inside Docker network (mysql service)
DATABASE_URL="mysql://glowuser:GlowUserPass2026!@mysql:3306/treasure_hunt"

# Application Public URL
NEXT_PUBLIC_APP_URL="https://glowfiesta2026.e-connectsolutions.com"

# Session Secret (must be at least 32 characters)
SESSION_PASSWORD="glowfiesta-super-secret-session-key-min-32-chars!"

# Default Organizer Password
ORGANIZER_PASSWORD="admin"

# MySQL Root and Application Credentials
MYSQL_ROOT_PASSWORD="RootPass2026!"
MYSQL_DATABASE="treasure_hunt"
MYSQL_USER="glowuser"
MYSQL_PASSWORD="GlowUserPass2026!"
